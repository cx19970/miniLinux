#!/bin/busybox sh
# This initramfs is the running root (no pivot).

PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH
BB=/bin/busybox

"$BB" mount -t proc proc /proc
"$BB" mount -t sysfs sysfs /sys
"$BB" mount -t devtmpfs devtmpfs /dev 2>/dev/null \
    || "$BB" mount -t tmpfs tmpfs /dev

[ -e /dev/console ] || "$BB" mknod -m 622 /dev/console c 5 1
[ -e /dev/null ] || "$BB" mknod -m 666 /dev/null c 1 3

# BusyBox applets (ls, mount, getty, mdev, ...) become FHS symlinks here, at
# boot, and not at pack time: scripts/mkinitramfs.sh may run on a host that
# cannot execute the target-arch busybox (cross-compile). --list-full lists
# FHS paths relative to the root (bin/ls, usr/bin/awk, sbin/init, ...);
# names already taken by real binaries (GNU wget, kmod, e2fsck, ...) are
# left untouched.
applet_list=/tmp/.busybox-applets
"$BB" --list-full >"$applet_list" 2>/dev/null
if [ -s "$applet_list" ]; then
    while IFS= read -r rel; do
        [ -n "$rel" ] || continue
        case "$rel" in
            /*) dest="$rel" ;;
            *) dest="/$rel" ;;
        esac
        if [ -e "$dest" ] || [ -L "$dest" ]; then
            continue
        fi
        dir=${dest%/*}
        [ -n "$dir" ] || dir=/
        "$BB" mkdir -p "$dir"
        "$BB" ln -sf "$BB" "$dest"
    done <"$applet_list"
else
    # busybox without --list-full: let it install its own applet set.
    "$BB" --install -s 2>/dev/null || true
fi
"$BB" rm -f "$applet_list"
# bin/sh is in --list-full, but never leave the root without a shell.
[ -e /bin/sh ] || "$BB" ln -sf "$BB" /bin/sh

exec "$BB" sh
