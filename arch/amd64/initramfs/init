#!/bin/busybox sh
# This initramfs is the running root (no pivot).

busybox mount -t proc proc /proc
busybox mount -t sysfs sysfs /sys
busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null \
    || busybox mount -t tmpfs tmpfs /dev

[ -e /dev/console ] || busybox mknod -m 622 /dev/console c 5 1
[ -e /dev/null ] || busybox mknod -m 666 /dev/null c 1 3

busybox --install -s 2>/dev/null || true

exec busybox sh
